# DJI Mavic 2 Pro Drone Payload
DEF MAVIC_2_PRO Mavic2Pro {
  translation 0 0.15 0
  rotation 0 1 0 0
  controller "<extern>"
  supervisor TRUE
  cameraSlot [
    Camera {
      width 960
      height 720
      fieldOfView 1.45
