#VRML_SIM R2023b utf-8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/robots/dji/mavic/protos/Mavic2Pro.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/humans/pedestrian/protos/Pedestrian.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"

WorldInfo {
  info [
    "Autonomous Drone Smart Crowd Monitoring Surveillance World"
    "Mavic 2 Pro with EXTERN controller inspecting crowd plaza and portrait billboards"
  ]
  title "Smart Crowd Monitoring Plaza"
  basicTimeStep 32
  coordinateSystem "NUE"
}

Viewpoint {
  orientation -0.57 0.70 0.42 1.3
  position 35 45 40
  near 0.2
}

TexturedBackground {}
TexturedBackgroundLight {}

RectangleArena {
  translation 0 0 0
  floorSize 60 60
  floorTileSize 2 2
  wallHeight 2
}

Solid {
  translation 0 0.8 0
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.7 0.6 0.5
        roughness 0.6
      }
      geometry Cylinder {
        height 1.6
        radius 3.0
      }
    }
  ]
  boundingObject Cylinder {
    height 1.6
    radius 3.0
  }
}

DEF BILLBOARD_ALICE Solid {
  translation 6.0 1.6 8.0
  rotation 0 1 0 0.0
  children [
    Transform {
      translation 0 -0.8 0
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.3 0.3 0.3 }
          geometry Cylinder { height 1.6 radius 0.08 }
        }
      ]
    }
    Shape {
      appearance PBRAppearance {
        baseColorMap ImageTexture {
          url [ "../data/billboards/billboard_alice.jpg" ]
        }
        roughness 0.4
      }
      geometry Box { size 2.0 1.8 0.1 }
    }
  ]
  boundingObject Box { size 2.0 3.2 0.2 }
}

